/target
**/*.rs.bk
*.pdb

# Render output from `engine screenshot` / `engine diff-render`
/out
*.png
!examples/**/baselines/*.png
# Source textures are assets, not output — they are generated by
# examples/textures/make_textures.py and referenced by committed scenes, so a
# checkout without them fails validation (M26 shipped without them for exactly
# one commit).
!examples/textures/*.png

.DS_Store

# Python bytecode from the scene generators
__pycache__/

# Worktrees for parallel sessions live here; they are checkouts, not content.
.claude/worktrees/

# Video captures of the showcase tour — render output, like the PNGs above.
/recordings/
