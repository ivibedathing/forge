      "Bash(cargo clippy:*)",
      "Bash(cargo run -p engine-cli:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(jq:*)",
      "Bash(cmp:*)",
      "Bash(python3 examples/scenes/make_car_track.py:*)",
      "Bash(python3 examples/scenes/make_car_track_lap.py:*)"
