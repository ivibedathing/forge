{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bin/engine:*)",
      "Bash(./bin/engine:*)",
      "Bash(ENGINE_PROFILE=release bin/engine:*)",
      "Bash(bin/verify-baselines:*)",
      "Bash(./bin/verify-baselines:*)",
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
